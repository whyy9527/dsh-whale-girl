{
  "name": "dsh-whale-girl",
  "version": "0.1.0",
  "description": "macOS 鲸鱼娘桌宠：看屏、文字输入、DSH 工具会话、头像与全身、本地 Qwen 语音",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./core": "./lib/core.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2",
    "node": ">=24.13.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "license": "CC-BY-NC-SA-4.0",
  "files": [
    "lib/*.js",
    "app/*.py",
    "scripts/*.sh",
    "scripts/*.py",
    "assets",
    "addons",
    "cordis.patch.yml",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    ".node-version",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "AGENTS.md",
    "docs",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/whyy9527/dsh-whale-girl.git"
  }
